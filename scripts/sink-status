#!/usr/bin/env bash
# Prints one line per PulseAudio sink for the service:
#   <sink name> TAB <available 0|1> TAB <port count> TAB <active port> TAB <active port description>
# Availability comes from Omarchy's own helper so speaker tunings stay hidden;
# the port columns let the service treat each active port of a multi-port card
# (speakers vs. the headphone jack) as its own device.
set -euo pipefail

availability=$(timeout 2 omarchy-audio-sink-availability 2>/dev/null || true)

timeout 2 pactl list sinks 2>/dev/null | awk -v availability="$availability" '
  BEGIN {
    count = split(availability, rows, "\n")
    for (i = 1; i <= count; i++) {
      split(rows[i], cols, "\t")
      if (cols[1] != "") available_for[cols[1]] = cols[2]
    }
  }

  function emit_sink() {
    if (name == "") return
    avail = (name in available_for) ? available_for[name] : 1
    printf "%s\t%s\t%d\t%s\t%s\n", name, avail, port_count, active, port_desc[active]
  }

  /^Sink #/ {
    emit_sink()
    name = ""
    active = ""
    in_ports = 0
    port_count = 0
    delete port_desc
    next
  }

  /^[[:space:]]*Name:/ {
    name = $2
    next
  }

  /^[[:space:]]*Ports:$/ {
    in_ports = 1
    next
  }

  in_ports && /^\tActive Port:/ {
    in_ports = 0
    active = $0
    sub(/^\tActive Port: ?/, "", active)
    next
  }

  in_ports && /^\t\t/ {
    port_count++
    line = $0
    sub(/^\t\t/, "", line)
    port = line
    sub(/: .*$/, "", port)
    desc = line
    sub(/^[^:]*: /, "", desc)
    sub(/ \(.*$/, "", desc)
    port_desc[port] = desc
    next
  }

  END {
    emit_sink()
  }
'
