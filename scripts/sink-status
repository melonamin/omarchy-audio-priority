#!/usr/bin/bash
# Prints one line per PulseAudio sink for the service:
#   <sink name> TAB <available 0|1> TAB <port count> TAB <active port> TAB <active port description>
# Availability comes from Omarchy's own helper so speaker tunings stay hidden;
# the port columns let the service treat each active port of a multi-port card
# (speakers vs. the headphone jack) as its own device.
set -euo pipefail

export LC_ALL=C

tool() {
  local name=$1
  if [[ -n ${AUDIO_PRIORITY_TEST_BIN:-} ]]; then
    [[ $AUDIO_PRIORITY_TEST_BIN == /* && -x $AUDIO_PRIORITY_TEST_BIN/$name ]] || return 1
    printf '%s\n' "$AUDIO_PRIORITY_TEST_BIN/$name"
  else
    [[ -x /usr/bin/$name ]] || return 1
    printf '%s\n' "/usr/bin/$name"
  fi
}

timeout_bin=/usr/bin/timeout
head_bin=/usr/bin/head
awk_bin=/usr/bin/awk
pactl_bin=$(tool pactl) || { echo "Required pactl executable is unavailable" >&2; exit 69; }
availability_bin=$(tool omarchy-audio-sink-availability) \
  || { echo "Required Omarchy sink helper is unavailable" >&2; exit 69; }
availability_limit=32768
output_limit=131072

if ! availability=$("$timeout_bin" -k 1s 3s "$availability_bin" 2>/dev/null \
    | "$head_bin" -c $((availability_limit + 1))); then
  echo "Could not determine trusted sink availability" >&2
  exit 1
fi
if (( ${#availability} > availability_limit )); then
  echo "Sink availability output exceeded its limit" >&2
  exit 65
fi

if ! result=$("$timeout_bin" -k 1s 3s "$pactl_bin" list sinks 2>/dev/null \
  | "$awk_bin" -v availability="$availability" '
  BEGIN {
    count = split(availability, rows, "\n")
    for (i = 1; i <= count; i++) {
      split(rows[i], cols, "\t")
      if (cols[1] != "") available_for[cols[1]] = cols[2]
    }
  }

  function emit_sink() {
    if (name == "") return
    avail = (name in available_for) ? available_for[name] : 0
    printf "%s\t%s\t%d\t%s\t%s\n", name, avail, port_count, active, port_desc[active]
  }

  /^Sink #/ {
    emit_sink()
    name = ""
    active = ""
    in_ports = 0
    port_count = 0
    delete port_desc
    next
  }

  /^[[:space:]]*Name:/ {
    name = $2
    next
  }

  /^[[:space:]]*Ports:$/ {
    in_ports = 1
    next
  }

  in_ports && /^\tActive Port:/ {
    in_ports = 0
    active = $0
    sub(/^\tActive Port: ?/, "", active)
    next
  }

  in_ports && /^\t\t/ {
    port_count++
    line = $0
    sub(/^\t\t/, "", line)
    port = line
    sub(/: .*$/, "", port)
    desc = line
    sub(/^[^:]*: /, "", desc)
    sub(/ \(.*$/, "", desc)
    port_desc[port] = desc
    next
  }

  END {
    emit_sink()
  }
' | "$head_bin" -c $((output_limit + 1))); then
  echo "Could not read bounded sink status" >&2
  exit 1
fi
if (( ${#result} > output_limit )); then
  echo "Sink status output exceeded its limit" >&2
  exit 65
fi
[[ -z $result ]] || printf '%s\n' "$result"
