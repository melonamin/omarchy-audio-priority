#!/usr/bin/env bash
set -euo pipefail
case ${1:-} in
  get-default-sink) cat "$AUDIO_PRIORITY_TEST_DIR/sink" ;;
  get-default-source) cat "$AUDIO_PRIORITY_TEST_DIR/source" ;;
  subscribe) exit 0 ;;
  list)
    [[ ${2:-} == sinks ]] || { echo "unexpected pactl invocation: $*" >&2; exit 64; }
    cat "$AUDIO_PRIORITY_TEST_DIR/list-sinks"
    ;;
  *) echo "unexpected pactl invocation: $*" >&2; exit 64 ;;
esac
